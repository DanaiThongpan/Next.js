# No real connection is allowed until the user explicitly enables access locally.
# enabled, disabled
DAAM_DB_ACCESS=disabled
DAAM_DB_HOST=192.168.15.201
DAAM_DB_PORT=3306
DAAM_DB_NAME=daam
DAAM_DB_CHARSET=utf8mb4
DAAM_DB_USER=esdev
DAAM_DB_PASSWORD=
DAAM_DB_POOL_LIMIT=2
# Existing DB_* settings are also supported. Use one credential pair.
# Absolute path to the existing legacy control/daam_dev.sqlite file.
DAAM_SQLITE_PATH=
# For production only, set an exact HTTPS origin locally.
# APP_ORIGIN=https://your-internal-host

# Explicit opt-in for scoped approval/rejection/return transactions only.
# Does not enable MySQL writes, mail delivery or migrations.
# Writes also require a separate SQLite file under .daam-runtime/data.
# Never enable writes against a database shared with another application.
DAAM_SQLITE_WRITES=disabled

# Credentials for the legacy UBU REST Mail API. Set privately on the server.
SMTP_USER=
SMTP_PASS=
