{
  "name": "daam-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 DAAM_DB_ACCESS=disabled next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:auth": "DAAM_DB_ACCESS=disabled node --import ./tests/offline-network-guard.mjs --experimental-strip-types --test tests/auth.test.ts",
    "test:dashboard": "DAAM_DB_ACCESS=disabled node --import ./tests/offline-network-guard.mjs --experimental-strip-types --test tests/dashboard.test.ts",
    "build:offline": "NEXT_TELEMETRY_DISABLED=1 DAAM_DB_ACCESS=disabled node --import ./tests/offline-network-guard.mjs ./node_modules/next/dist/bin/next build --webpack",
    "test:db": "DAAM_DB_ACCESS=disabled node --import ./tests/offline-network-guard.mjs --conditions=react-server --experimental-strip-types --test tests/database.test.ts",
    "test:offline": "DAAM_DB_ACCESS=disabled node --import ./tests/offline-network-guard.mjs --conditions=react-server --experimental-strip-types --test tests/auth.test.ts tests/dashboard.test.ts tests/database.test.ts && npm run test:components",
    "test:components": "DAAM_DB_ACCESS=disabled node --import ./tests/offline-network-guard.mjs --test tests/dashboard-components.test.mjs",
    "test:qr-loan": "node --import ./tests/offline-network-guard.mjs --experimental-strip-types --test tests/qr-loan.test.mjs"
  },
  "dependencies": {
    "@fontsource/prompt": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "~5.3.0",
    "chart.js": "^4.6.1",
    "jsqr": "^1.4.0",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
